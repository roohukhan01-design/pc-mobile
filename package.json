{
  "name": "roohu-connect",
  "version": "0.1.0",
  "description": "Roohu Connect for Windows",
  "author": "Roohu <roohukhan01@gmail.com>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "bonjour-service": "1.2.1",
    "qrcode": "1.5.4",
    "selfsigned": "2.4.1",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "electron": "32.1.2",
    "electron-builder": "25.0.5"
  },
  "build": {
    "appId": "com.roohu.connect",
    "productName": "Roohu Connect",
    "files": ["main.js", "preload.js", "server.js", "renderer/**"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
